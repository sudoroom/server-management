# Disallow root user to log in at all.
PermitRootLogin yes

# Turn most ssh features off, and selectively re-enable them per user as needed.
AllowAgentForwarding no
AllowTcpForwarding no
PermitTTY no
PermitUserRC no

AllowUsers sean

Match Group wheel
	PermitTTY yes
